# OpenAI API Key (required for gpt-5-nano)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Set custom API base URL
# OPENAI_API_BASE=https://api.openai.com/v1

# Local S3/MinIO worker settings
API_SECRET_KEY=local-transform-secret
TRANSFORM_API_SECRET_KEY=local-transform-secret
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=modernfiction
R2_SECRET_ACCESS_KEY=modernfiction-password
R2_BUCKET_NAME=modernfiction
R2_PUBLIC_URL=http://localhost:9000/modernfiction
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1
