{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modernfiction-frontend",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "vars": {
    "VITE_API_URL": "https://api.alexandria0.com"
  },
  "routes": [
    {
      "pattern": "alexandria0.com",
      "custom_domain": true
    },
    {
      "pattern": "www.alexandria0.com",
      "custom_domain": true
    }
  ]
}
